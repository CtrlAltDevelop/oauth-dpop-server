# Copy to .env and adjust. Nothing here is a real secret.

DJANGO_DEBUG=true
# Required when DJANGO_DEBUG is off. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Postgres in production; SQLite is used when this is unset.
DATABASE_URL=postgres://oauth:oauth@localhost:5432/oauth
REDIS_URL=redis://localhost:6379/0

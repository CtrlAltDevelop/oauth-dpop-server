# The server reads the process environment only; export these, or load the
# file with your process manager. Nothing here is a real secret.

DJANGO_DEBUG=true
# Required when DJANGO_DEBUG is off. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Postgres in production; SQLite is used when this is unset.
DATABASE_URL=postgres://oauth:oauth@localhost:5432/oauth
REDIS_URL=redis://localhost:6379/0
# The issuer identifier: the public origin of this server, no trailing slash.
OAUTH_ISSUER=http://localhost:8000
# Private signing keys are encrypted under a key derived from this. Defaults
# to DJANGO_SECRET_KEY; set it separately in production.
OAUTH_KEY_ENCRYPTION_SECRET=
